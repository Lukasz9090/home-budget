# Single deployable unit: Angular build bundled into Spring Boot's static resources.
# Vercel detects this file, builds the image and serves it from a Vercel Function (region: vercel.json).
# Local check: docker build -f Dockerfile.vercel -t pennyplan . && docker run -p 8080:8080 -e PORT=8080 pennyplan

# --- 1. Frontend -------------------------------------------------------------
FROM node:24-slim AS frontend
WORKDIR /app/frontend
COPY frontend/package.json frontend/package-lock.json ./
# Use the npm version pinned in package.json "packageManager"; newer npm rejects this lockfile.
RUN npm install -g "$(node -p "require('./package.json').packageManager")" && npm ci
COPY frontend/ ./
RUN npm run build

# --- 2. Backend (with the Angular build in static/) --------------------------
FROM eclipse-temurin:21-jdk AS backend
WORKDIR /app/backend
COPY backend/.mvn/ .mvn/
COPY backend/mvnw backend/pom.xml ./
RUN sh mvnw -B -q dependency:go-offline
COPY backend/src/ src/
COPY --from=frontend /app/frontend/dist/frontend/browser/ src/main/resources/static/
RUN sh mvnw -B -q package -DskipTests && cp target/home-budget-*.jar /app/app.jar

# --- 3. Runtime --------------------------------------------------------------
FROM eclipse-temurin:21-jre
RUN useradd --system --uid 10001 app
USER app
WORKDIR /app
COPY --from=backend /app/app.jar app.jar
# Vercel sets PORT (defaults to 80); Spring binds server.port to ${PORT:8080}.
ENV PORT=80
# Hobby instances are fixed at 2 GB; C1-only JIT shortens cold start.
ENV JAVA_TOOL_OPTIONS="-XX:MaxRAMPercentage=75 -XX:TieredStopAtLevel=1"
EXPOSE 80
ENTRYPOINT ["java", "-jar", "/app/app.jar"]
